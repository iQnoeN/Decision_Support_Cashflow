# =============================================================
# Decision Support Cashflow — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# =============================================================

# ── PostgreSQL (Supabase) ─────────────────────────────────────
# Direct connection for async SQLAlchemy (use asyncpg driver prefix)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.oqhgvumktpirnomffusk.supabase.co:5432/postgres

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Email (SMTP) ─────────────────────────────────────────────
# For Gmail: enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CashflowAI

# ── App ───────────────────────────────────────────────────────
# URL where your frontend is running (used in verification email link)
FRONTEND_URL=http://localhost:5173
DEBUG=False
